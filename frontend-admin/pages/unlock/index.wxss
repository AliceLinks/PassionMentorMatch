.unlock-container {
    padding: 48px 24px 0 24px;
    text-align: center;
}

.unlock-title {
    font-size: 18px;
    font-weight: 600;
    margin-bottom: 8px;
}

.prompt {
    color: #666;
    margin-bottom: 18px;
}

.single-box {
    width: 320px;
    margin: 0 auto 12px;
}

.single-input {
    width: 100%;
    height: 44px;
    padding: 8px 12px;
    border-radius: 6px;
    border: 1px solid #e6e6e6;
    box-sizing: border-box;
}

.submit-btn {
    width: 320px;
    margin: 0 auto;
    display: block;
    height: 40px;
    line-height: 40px;
    border-radius: 6px;
    background: #16dc5f;
    color: #fff;
    border: none;
}

.error {
    color: #f5222d;
    margin-top: 12px;
    min-height: 24px;
    font-size: 14px;
}