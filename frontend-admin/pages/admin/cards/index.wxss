.card-issue-form {
    padding: 32rpx;
    background: #fff;
    border-radius: 16rpx;
    box-shadow: 0 2rpx 8rpx #eee;
    margin: 32rpx;
}

.form-item {
    display: flex;
    align-items: center;
    margin-bottom: 24rpx;
}

.form-item text {
    width: 160rpx;
    font-size: 30rpx;
}

.form-item input {
    flex: 1;
    border: 1rpx solid #ddd;
    border-radius: 8rpx;
    padding: 12rpx 20rpx;
    font-size: 28rpx;
}

.picker {
    flex: 1;
    padding: 12rpx 20rpx;
    border: 1rpx solid #ddd;
    border-radius: 8rpx;
    font-size: 28rpx;
    background: #f8f8f8;
}

.result {
    margin-top: 32rpx;
    color: #00796b;
    font-size: 32rpx;
    text-align: center;
}

button {
    width: 100%;
    margin-top: 16rpx;
}