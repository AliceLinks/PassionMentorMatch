.container{ padding:16px; background:#f7f8fa; min-height:100vh; }
.card{ background:#fff; border-radius:12px; box-shadow:0 6px 16px rgba(0,0,0,0.08); padding:14px; margin-bottom:14px; }
.card-title{ font-size:16px; font-weight:600; color:#222; margin-bottom:10px; }
.field{ display:flex; align-items:center; gap:12rpx; margin-bottom:16rpx; }
.label{ width:180rpx; color:#666; }
.input{ flex:1; background:#fff; border:1rpx solid #eee; border-radius:8rpx; padding:12rpx; }
.picker-value{ flex:1; background:#fff; border:1rpx solid #eee; border-radius:8rpx; padding:12rpx; color:#333; }
.primary{ background:#07c160; color:#fff; border-radius:999rpx; }
.btn-secondary{ background:#fff; color:#ff4d4f; border:1px solid #ff4d4f; border-radius:8px; }
.section-title{ font-size:15px; font-weight:600; color:#333; margin:10px 4px; }
.rec-item{ display:flex; align-items:center; justify-content:space-between; padding:10px; border:1px solid #eee; border-radius:10px; background:#fff; margin-bottom:8px; }
.rec-title{ font-size:14px; font-weight:600; color:#222; }
.rec-time{ font-size:12px; color:#888; margin-top:4px; }
.muted{ color:#999; font-size:12px; text-align:center; padding:8px; }