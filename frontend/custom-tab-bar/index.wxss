.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 120rpx;
  display: flex;
  background: linear-gradient(90deg, #18181b 0%, #23272f 100%);
  border-top: none;
  box-shadow: 0 -8rpx 32rpx rgba(255,120,40,0.10);
  padding: 10rpx 16rpx;
  z-index: 999;
}
.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #bdbdbd;
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  transition: color 0.2s;
}
.tab-item.active {
  color: #ff6a00;
  text-shadow: 0 4rpx 12rpx rgba(255,120,40,0.18);
}
.icon {
  width: 64rpx;
  height: 64rpx;
  margin-bottom: 6rpx;
  filter: drop-shadow(0 2rpx 8rpx rgba(255,120,40,0.10));
  transition: transform 0.2s;
}
.tab-item.active .icon {
  transform: scale(1.12);
  filter: drop-shadow(0 6rpx 18rpx rgba(255,120,40,0.18));
}
.label {
  font-size: 28rpx;
  margin-top: 8rpx;
  font-family: 'DIN', 'Arial', sans-serif;
  letter-spacing: 2rpx;
}
