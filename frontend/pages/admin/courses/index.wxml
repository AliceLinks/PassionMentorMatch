<view class="container">
  <!-- 表单卡片（统一为编辑页样式） -->
  <view class="card">
    <view class="card-title">新增课程到批量</view>
    <view class="field">
      <text class="label">日期</text>
      <picker mode="date" value="{{date}}" start="{{pickerMinDate}}" bindchange="onDatePick">
        <view class="picker-value">{{date || '请选择日期'}}</view>
      </picker>
    </view>
    <view class="field">
      <text class="label">开始时间</text>
      <picker mode="time" value="{{start}}" bindchange="onStartPick">
        <view class="picker-value">{{start || '请选择开始时间'}}</view>
      </picker>
    </view>
    <view class="field">
      <text class="label">结束时间</text>
      <picker mode="time" value="{{end}}" bindchange="onEndPick">
        <view class="picker-value">{{end || '请选择结束时间'}}</view>
      </picker>
    </view>
    <view class="field"><text class="label">导师</text><input class="input" placeholder="如：王老师" bindinput="onTeacher" /></view>
    <view class="field"><text class="label">舞种</text><input class="input" placeholder="如：Jazz" bindinput="onDance" /></view>
    <view class="field"><text class="label">容量</text><input class="input" placeholder="人数（正整数）" type="number" bindinput="onCapacity" /></view>
    <button class="primary" bindtap="addItem">添加到本次批量</button>
  </view>

  <!-- 列表卡片 -->
  <view class="card">
    <view class="card-title">待发布列表</view>
    <block wx:for="{{items}}" wx:key="index">
        <view class="rec-item">
        <view class="left">
          <view class="rec-title">{{item.dance_type}} · {{item.teacher}}</view>
          <view class="rec-time">{{item.course_date}} {{item.start_time}}-{{item.end_time}} 容量:{{item.capacity}}</view>
        </view>
          <view class="actions">
            <button class="btn-secondary" size="mini" data-index="{{index}}" bindtap="removeItem">移除</button>
          </view>
      </view>
    </block>
    <view wx:if="{{items.length===0}}" class="muted">尚未添加课程</view>
    <button class="btn" bindtap="onSubmit" style="margin-top:12px;">提交批量发布</button>
  </view>
</view>