<view class="page">
  <view class="bg-gradient"></view>

  <view class="header">
    <image class="logo" src="https://mmbiz.qpic.cn/mmbiz/icTdbqWNOwNRna42FI242Lcia07jQodd2FJGIYQfG0LAJGFxM4FbnQP6yfMxBgJ0F3YRqJCJ1aPAK2dQagdusBZg/0" mode="aspectFill" />
    <view class="title">管理员后台</view>
    <view class="subtitle">Passion 导师课管理端登录</view>
  </view>

  <view class="card">
    <view class="form-item">
      <view class="label">管理员手机号</view>
      <input class="input" placeholder="请输入管理员手机号" type="number" bindinput="onPhoneInput" />
    </view>

    <view class="form-item">
      <view class="label">登录密码</view>
      <input class="input" placeholder="请输入密码" password="true" bindinput="onPasswordInput" />
    </view>

    <button class="primary-btn"
            loading="{{loading}}"
            disabled="{{loading}}"
            bindtap="onSubmit">
      {{ loading ? '登录中...' : '登录' }}
    </button>

    <view class="tip">
      仅限社团管理员使用，如有问题请联系系统维护同学
    </view>
  </view>
</view>