<view class="container">
  <view class="hero">
    <view class="hero-title">管理员总览</view>
    <view class="hero-sub">快速进入常用功能</view>
  </view>

  <view class="grid">
    <view class="card" bindtap="goManageCourses">
      <view class="card-icon">⚙️</view>
      <view class="card-title">课程管理</view>
      <view class="card-sub">取消或编辑已发布课程</view>
    </view>
    <view class="card" bindtap="goCourses">
      <view class="card-icon">📦</view>
      <view class="card-title">批量发布课程</view>
      <view class="card-sub">创建并发布一周课程</view>
    </view>
    <!-- 预约名单入口已移至课程管理详情页 -->
    <view class="card" bindtap="goCheckin">
      <view class="card-icon">✅</view>
      <view class="card-title">签到核销</view>
      <view class="card-sub">扫码或手动核销</view>
    </view>
  </view>
</view>