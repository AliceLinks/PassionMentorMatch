.container{ padding:16px; background:#f7f8fa; min-height:100vh; }
.card{ background:#fff; border-radius:12px; box-shadow:0 6px 16px rgba(0,0,0,0.08); padding:14px; margin-bottom:14px; }
.card-title{ font-size:16px; font-weight:600; color:#222; margin-bottom:10px; }
.picker-row{ display:flex; align-items:center; padding:10px; border:1px solid #eee; border-radius:8px; background:#fafafa; }
.label{ width:88px; color:#666; font-size:13px; }
.value{ flex:1; color:#222; font-size:14px; }
.btn{ margin-top:12px; background:#07c160; color:#fff; border-radius:8px; }
.list-item{ display:flex; align-items:center; justify-content:space-between; padding:10px; border:1px solid #eee; border-radius:10px; background:#fff; margin-bottom:8px; }
.list-left{ display:flex; align-items:center; gap:10px; }
.avatar{ width:36px; height:36px; border-radius:50%; background:#eee; }
.info{ display:flex; flex-direction:column; }
.title{ font-size:14px; font-weight:600; color:#222; }
.sub{ font-size:12px; color:#888; margin-top:2px; }
.badge{ display:inline-block; padding:2px 6px; font-size:12px; color:#fff; background-color:#007aff; border-radius:4px; }
.badge.grey{ background-color:#8a8a8a; margin-left:6px; }
.badge.green{ background-color:#07c160; margin-left:6px; }
.empty{ color:#999; font-size:12px; text-align:center; padding:8px; }