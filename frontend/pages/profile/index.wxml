<view class="container">
    <view class="profile-header">
        <view class="profile-card">
        <image src="{{user.avatar}}" class="avatar" />
        <view class="info">
            <view class="name">{{user.nickname}}</view>
            <view class="meta">积分 {{user.points}} · 等级 {{user.level}}</view>
        </view>
        <button class="btn" size="mini" bindtap="goEdit">修改资料</button>
        </view>
    </view>

  <view class="section-title">我的导师卡</view>
  <view class="cards-container">
    <block wx:for="{{cards}}" wx:key="id">
      <view class="mentor-card {{item.status}}">
        <view class="card-type">{{item.card_type === 'semester' ? '学期卡' : (item.card_type === 'annual' ? '年卡' : '终身卡')}}</view>
        <view class="card-no">NO. {{item.card_number}}</view>
        <view class="card-date">有效期至: {{item.end_date}}</view>
        <view class="card-status">{{item.status === 'active' ? '生效中' : '已失效'}}</view>
      </view>
    </block>
    <view wx:if="{{cards.length === 0}}" class="empty-card">暂无有效导师卡</view>
  </view>

  <view class="menu-list">
    <view class="menu-item" bindtap="goReservations">
      <text>我的预约记录</text>
      <text class="arrow">></text>
    </view>
  </view>
</view>
