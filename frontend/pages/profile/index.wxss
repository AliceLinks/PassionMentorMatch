.card + .card {
  margin-top: 16rpx;
}
.profile-header {
  background: linear-gradient(135deg, #07c160 0%, #22c55e 50%, #a7f3d0 100%);
  border-radius: 16rpx;
  padding: 24rpx;
  color: #fff;
}
.profile-card {
  display:flex;align-items:center;gap:16rpx;
}
.avatar { width:96rpx;height:96rpx;border-radius:50%; }
.info { flex:1; }
.name { font-size:32rpx;font-weight:600; }
.meta { color:#e6fffb; }
.quick-actions { display:flex;gap:16rpx;margin:16rpx 0; }
.qa-item { flex:1;background:#fff;border-radius:12rpx;padding:16rpx;display:flex;flex-direction:column;align-items:center;gap:8rpx;box-shadow:0 4rpx 12rpx rgba(0,0,0,0.06); }
.qa-icon { font-size:40rpx; }
.qa-text { color:#333; }
.list-item { display:flex;justify-content:space-between;align-items:center;padding:16rpx;background:#fff;border-radius:12rpx;margin-bottom:12rpx; }
.muted { color:#666; }
.more-link { color:#07c160;margin-bottom:16rpx; }
/* 页面基本样式 */
.page {
  min-height: 100vh;
  background: #f5f6fa;
  padding: 32rpx 24rpx 40rpx;
  box-sizing: border-box;
}

/* 头部用户信息 */
.header {
  display: flex;
  align-items: center;
  padding: 24rpx 20rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #ff7a45, #ffbb96);
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.12);
  margin-bottom: 32rpx;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.9);
}

.info {
  margin-left: 24rpx;
  flex: 1;
}

.name {
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
  margin-bottom: 6rpx;
}

.sub {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-bottom: 4rpx;
}

.status {
  display: inline-block;
  margin-top: 4rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: #10b981;
  background: rgba(255, 255, 255, 0.9);
}

.status.guest {
  color: #f97316;
}

/* 卡片与菜单 */
.card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 20rpx 20rpx 8rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.04);
}

.card-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #111827;
  margin-bottom: 8rpx;
}

.card-desc {
  font-size: 24rpx;
  color: #6b7280;
  margin-bottom: 16rpx;
}

.menu-item {
  padding: 18rpx 4rpx;
  border-bottom: 1rpx solid #f3f4f6;
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 26rpx;
  color: #374151;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item.logout {
  color: #ef4444;
}

.arrow {
  color: #9ca3af;
  font-size: 28rpx;
}

/* 主要按钮（未登录时显示） */
.primary-btn {
  margin-top: 12rpx;
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #ff7a45, #ff4d4f);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 500;
  border: none;
}
