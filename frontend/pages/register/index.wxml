<view class="register-bg">
  <view class="card register-card">
    <view class="card-body">
      <view class="register-title">注册新账号</view>
      <button class="avatar-btn" open-type="chooseAvatar" bind:chooseavatar="onChooseAvatar">
        <image class="avatar" src="{{avatarUrl || defaultAvatarUrl}}" mode="aspectFill" />
        <view class="avatar-tip">上传头像</view>
      </button>
      <view class="avatar-hint">请选择本人真实照片</view>
      <view class="input-row"><input class="input" type="text" placeholder="姓名" maxlength="20" bindinput="onNameInput" value="{{realName}}" /></view>
      <view class="input-row"><input class="input" type="text" placeholder="手机号" maxlength="11" bindinput="onPhoneInput" value="{{phone}}" /></view>
      <view class="input-row"><input class="input" type="password" placeholder="密码" maxlength="32" bindinput="onPasswordInput" value="{{password}}" /></view>
      <button class="btn register-btn" bindtap="onRegister" loading="{{loading}}">注册</button>
    </view>
  </view>
</view>