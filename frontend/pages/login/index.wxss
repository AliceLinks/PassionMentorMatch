.register-bg {
	min-height: 100vh;
	background: linear-gradient(135deg, #d1fae5 0%, #bbf7d0 100%);
	display: flex;
	align-items: center;
	justify-content: center;
}
.register-card {
	box-shadow: 0 8rpx 32rpx 0 rgba(34,197,94,0.10);
	margin: 0 auto;
	max-width: 600rpx;
}
.register-title {
	font-size: 36rpx;
	font-weight: bold;
	color: #166534;
	text-align: center;
	margin-bottom: 32rpx;
}
.register-btn {
	margin-top: 24rpx;
	background: linear-gradient(90deg,#22c55e,#4ade80);
	box-shadow: 0 4rpx 16rpx 0 rgba(34,197,94,0.10);
	transition: background 0.3s;
}
.register-btn:active {
	background: linear-gradient(90deg,#4ade80,#22c55e);
}
.login-btn-secondary {
	margin-top: 16rpx;
	background: #eee;
	color: #333;
	box-shadow: none;
}
.login-btn {
	margin-top: 24rpx;
	background: linear-gradient(90deg,#6366f1,#38bdf8);
	box-shadow: 0 4rpx 16rpx 0 rgba(80,120,200,0.10);
	transition: background 0.3s;
}
.login-btn:active {
	background: linear-gradient(90deg,#38bdf8,#6366f1);
}
.login-btn-secondary {
	margin-top: 16rpx;
	background: #eee;
	color: #333;
	box-shadow: none;
}
/* pages/login/index.wxss */
.card { background:#fff;border-radius:12rpx;overflow:hidden;border:1rpx solid #e5e7eb; }
.card-body { padding:16rpx; }