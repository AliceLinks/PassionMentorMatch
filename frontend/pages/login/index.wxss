/* pages/login/index.wxss */
.page {
  min-height: 100vh;
  background: #f5f6fa;
  display: flex;
  justify-content: center;
  align-items: flex-start;
  padding: 80rpx 40rpx 40rpx;
  box-sizing: border-box;
  position: relative;
}

/* 顶部渐变背景条 */
.header-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 280rpx;
  background: linear-gradient(135deg, #ff7a45, #ffbb96);
  z-index: 0;
}

/* 中间白色卡片 */
.card {
  position: relative;
  z-index: 1;
  width: 100%;
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 18rpx 40rpx rgba(0, 0, 0, 0.08);
  padding: 40rpx 40rpx 32rpx;
  box-sizing: border-box;
}

/* logo / 头像 */
.logo-wrap {
  display: flex;
  justify-content: center;
  margin-top: -92rpx;
  margin-bottom: 16rpx;
}

.logo {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  border: 6rpx solid rgba(255, 255, 255, 0.9);
  box-shadow: 0 10rpx 26rpx rgba(0, 0, 0, 0.12);
}

/* 标题文字 */
.title {
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #111827;
  margin-bottom: 8rpx;
}

.subtitle {
  text-align: center;
  font-size: 24rpx;
  color: #6b7280;
  margin-bottom: 32rpx;
}

/* 表单 */
.form {
  margin-top: 8rpx;
}

.field {
  margin-bottom: 28rpx;
}

.field-label {
  font-size: 26rpx;
  color: #4b5563;
  margin-bottom: 12rpx;
}

.field-input {
  width: 100%;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
  border-radius: 16rpx;
  background: #f9fafb;
  font-size: 28rpx;
  color: #111827;
  border: 2rpx solid #e5e7eb;
}

.field-input::placeholder {
  color: #9ca3af;
}

/* 主要按钮 */
.primary-btn {
  margin-top: 8rpx;
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #ff7a45, #ff4d4f);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 500;
  border: none;
}

.primary-btn[disabled] {
  opacity: 0.7;
}

/* 登录 / 注册切换 */
.switch-row {
  margin-top: 18rpx;
  display: flex;
  justify-content: center;
}

.switch-text {
  font-size: 24rpx;
  color: #ff7a45;
  text-decoration: underline;
}

/* 底部提示 */
.footer-tip {
  margin-top: 32rpx;
  text-align: center;
  font-size: 22rpx;
  color: #9ca3af;
}