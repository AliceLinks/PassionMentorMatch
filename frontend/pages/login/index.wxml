<!-- 登录页 -->
<view class="page">
  <view class="brand-hero">
    <image class="brand-logo" src="{{logoUrl}}" mode="aspectFit" />
    <view>
      <view class="brand-badge">PASSION STREET DANCE</view>
      <view class="brand-title">欢迎登录</view>
      <view class="neon-sub">导师课 · 预约系统</view>
    </view>
  </view>

  <view class="glass-card card register-card">
    <view class="card-body">
      <view class="register-title">手机号登录</view>

      <view class="input-row">
        <input class="input" type="text" placeholder="手机号" maxlength="11" bindinput="onPhoneInput" />
      </view>

      <view class="input-row" style="margin-top:16rpx;">
        <input class="input" type="password" placeholder="密码" maxlength="32" bindinput="onPasswordInput" />
      </view>

      <button class="btn-primary register-btn" bindtap="onLogin" loading="{{loading}}">{{ loading ? '登录中...' : '登录' }}</button>

      <button class="btn-secondary login-btn-secondary" bindtap="onRegister">注册新账号</button>
    </view>
  </view>
</view>