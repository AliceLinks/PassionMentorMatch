<view class="container">
  <view class="hero">
    <view class="hero-left">
      <image class="hero-logo" src="{{logoUrl}}" mode="aspectFill" />
    </view>
    <view class="hero-right">
      <view class="hero-badge">PASSION STREET DANCE</view>
      <view class="hero-title">导师课 · 预约系统</view>
      <view class="hero-sub">Beat the floor, not the queue.</view>
    </view>
  </view>

  <view class="grid">
    <view class="card">
      <view class="card-body">
        <view class="row">
          <text class="label">我的状态</text>
          <text class="value">{{user.realName || '游客'}}</text>
        </view>
        <view class="row-sub muted">卡片：{{cards.length}} 张 · 本周课程：{{stats.courseCount}} 门</view>
        <view class="actions">
          <button class="btn" bindtap="goCourse">立即约课</button>
          <button class="btn-secondary" bindtap="goProfile">我的中心</button>
        </view>
      </view>
    </view>

    <view class="card">
      <view class="card-body">
        <view class="section-title">本周推荐</view>
        <block wx:for="{{recommend}}" wx:key="id">
          <view class="rec-item">
            <view class="left">
              <view class="rec-title">{{item.dance_type}} · {{item.teacher}}</view>
              <view class="rec-time muted">{{item.course_date}} {{item.start_time}}-{{item.end_time}}</view>
            </view>
            <button class="btn" size="mini" data-id="{{item.id}}" bindtap="onBook">预约</button>
          </view>
        </block>
        <view wx:if="{{recommend.length===0}}" class="muted">暂无推荐课程</view>
      </view>
    </view>
  </view>

  <!-- 课程介绍展示 -->
  <view class="card">
    <view class="card-body">
      <view class="section-title">课程介绍</view>
      <view wx:if="{{courseIntro}}">
        <button class="link" bindtap="goCourseIntro">点击查看课程介绍</button>
      </view>
      <view wx:if="{{!courseIntro}}" class="muted">暂无课程介绍</view>
    </view>
  </view>

  <!-- 路线图展示 -->
  <view class="card">
    <view class="card-body">
      <view class="section-title">路线图</view>
      <button class="btn" wx:if="{{roadmapImg}}" bindtap="showRoadmapImg">查看路线图</button>
      <view wx:if="{{!roadmapImg}}" class="muted">暂无路线图</view>
    </view>
  </view>
  
</view>