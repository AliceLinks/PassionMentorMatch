.hero { background:#fff;border-radius:16rpx;padding:24rpx;margin-bottom:16rpx; }
.title { font-size:36rpx;font-weight:700;color:#111; }
.subtitle { color:#666;margin-top:8rpx; }
.row { display:grid; grid-template-columns: 1fr auto; align-items:center; }
.label { color:#333;font-weight:600; }
.value { color:#07c160; }
.row-sub { margin-top:8rpx; }
.actions { display:flex; gap:12rpx; margin-top:12rpx; }
.rec-item { display:grid; grid-template-columns: 1fr auto; align-items:center; padding:8rpx 0; border-top:1rpx solid #f0f0f0; }
.rec-item:first-child { border-top:none; }

.rec-title { font-size:30rpx;font-weight:600; }
.rec-time { font-size:24rpx; }
.section-title { font-size:28rpx; font-weight:600; margin-bottom:8rpx; }
.link { color: #07c160; text-decoration: underline; }


