page {
  background: #f3f4f6;
  color: #111827;
  font-size: 28rpx;
}

/* 统一页面容器：居中 + 最大宽度，类似 App 风格 */
.container {
  padding: 24rpx;
  box-sizing: border-box;
  max-width: 900rpx;
  margin: 0 auto;
}

/* 区块标题 */
.section-title {
  font-size: 32rpx;
  font-weight: 600;
  margin: 32rpx 0 20rpx;
  color: #111827;
}

/* 通用小标题/说明文字 */
.text-muted {
  color: #6b7280;
  font-size: 24rpx;
}

/* 网格布局：在手机端单列，方便在首页等页面复用 */
.grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 20rpx;
}

/* 卡片基础样式 */
.card {
  background-color: #ffffff;
  border-radius: 20rpx;
  overflow: hidden;
  border: 1rpx solid #e5e7eb;
  box-shadow: 0 10rpx 30rpx rgba(15, 23, 42, 0.06);
}

.card-body {
  padding: 24rpx 28rpx;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #111827;
}

.card-subtitle {
  font-size: 24rpx;
  color: #6b7280;
}

/* 行布局（如首页“我的状态”） */
.row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.row-sub {
  margin-top: 8rpx;
}

/* 标签样式，用于展示舞种、状态等 */
.tag {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  line-height: 1;
  background: #f3f4f6;
  color: #4b5563;
}

.tag-primary {
  background: #ecfdf3;
  color: #166534;
}

/* 通用按钮体系 */
button[type="primary"],
button.primary,
button.btn,
.btn,
.btn-primary,
.primary {
  background: linear-gradient(90deg, #ff6a00, #ffb86b) !important;
  color: #0f1724 !important;
  border: none !important;
  font-weight: 700;
  border-radius: 999rpx;
  box-shadow: 0 12rpx 36rpx rgba(255,120,40,0.12);
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
  transition: background 0.3s;
}

button[type="primary"]:active,
button.primary:active,
button.btn:active,
.btn:active,
.btn-primary:active,
.primary:active {
  opacity: 0.95;
}

/* 注释掉原有绿色按钮样式
.btn {
  background: linear-gradient(135deg, #22c55e, #16a34a);
  color: #ffffff;
  font-weight: 600;
}

.btn:active {
  background: linear-gradient(135deg, #16a34a, #15803d);
}
*/

/* 次按钮：灰 + 细边框 */
.btn-secondary {
  background: #fff7ed;
  color: #ff6a00;
  border: 1rpx solid #ffb86b;
  border-radius: 999rpx;
}

.btn-secondary:active {
  background: #e5e7eb;
}

/* 导航按钮：浅蓝背景，用于“查看详情”、“内容管理”等 */
.btn-navigate {
  background: #e0f2fe;
  color: #0c4a6e;
}

.btn-navigate:active {
  background: #bae6fd;
}

/* 禁用按钮 */
.btn-disabled {
  background: #e5e7eb;
  color: #9ca3af;
}
.btn-disabled:active {
  background: #e5e7eb;
}

/* 课程列表样式（约课页复用） */
.week-header {
  display: flex;
  justify-content: space-around;
  background: #ffffff;
  padding: 20rpx 0;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(15, 23, 42, 0.04);
}

.day-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  font-size: 22rpx;
  color: #6b7280;
}

.date-num {
  font-size: 32rpx;
  font-weight: 600;
  color: #111827;
  margin-top: 6rpx;
}

.course-card {
  background: #ffffff;
  border-radius: 18rpx;
  padding: 22rpx 24rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.04);
}

.card-left {
  width: 200rpx;
}

.card-center {
  flex: 1;
  padding: 0 20rpx;
}

.card-right {
  width: 140rpx;
  text-align: right;
}

.time {
  font-size: 32rpx;
  font-weight: 700;
  color: #111827;
}

.type {
  font-size: 24rpx;
  color: #6b7280;
  margin-top: 6rpx;
}

.teacher {
  font-size: 26rpx;
  color: #111827;
  margin-bottom: 4rpx;
}

.capacity {
  font-size: 22rpx;
  color: #6b7280;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.capacity progress {
  flex: 1;
}

/* 导师卡样式（我的卡片页 / 首页统计） */
.mentor-card {
  background: linear-gradient(135deg, #111827, #1f2937);
  color: #ffffff;
  border-radius: 24rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  position: relative;
  overflow: hidden;
}

.mentor-card.active {
  background: linear-gradient(135deg, #22c55e, #16a34a);
}

.mentor-card.expired {
  background: linear-gradient(135deg, #9ca3af, #6b7280);
}

.card-type {
  font-size: 36rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.card-no {
  font-size: 26rpx;
  opacity: 0.9;
}

.card-date {
  font-size: 24rpx;
  opacity: 0.85;
  margin-top: 10rpx;
}

.card-status {
  position: absolute;
  right: 32rpx;
  top: 26rpx;
  font-size: 24rpx;
  border: 1px solid rgba(255, 255, 255, 0.9);
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  backdrop-filter: blur(6rpx);
}

/* ===== brand / shared styles for high-end look ===== */
.brand-hero {
  padding: 28rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #07101a 0%, #0f1724 60%);
  box-shadow: 0 20rpx 50rpx rgba(2,6,23,0.6);
  display: flex;
  align-items: center;
  gap: 24rpx;
  overflow: hidden;
}

.brand-logo {
  width: 200rpx;
  height: 200rpx;
  border-radius: 32rpx;
  background: transparent; /* ensure no black bg */
  box-shadow: 0 18rpx 40rpx rgba(0,0,0,0.6), 0 0 30rpx rgba(255,120,40,0.08) inset;
  object-fit: contain;
}

.brand-badge {
  color: #ffb86b;
  font-size: 20rpx;
  letter-spacing: 2rpx;
  text-transform: uppercase;
  margin-bottom: 8rpx;
  text-shadow: 0 6rpx 18rpx rgba(255,120,40,0.12);
}

.brand-title {
  font-size: 42rpx;
  font-weight: 800;
  color: #ffffff;
  text-shadow: 0 6rpx 20rpx rgba(0,0,0,0.6);
}

.glass-card {
  background: linear-gradient(180deg, rgba(255,255,255,0.03), rgba(255,255,255,0.02));
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 12rpx 36rpx rgba(2,6,23,0.45);
  border: 1rpx solid rgba(255,255,255,0.04);
}

/* unified primary button */
.btn-primary {
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 999rpx;
  padding: 0 36rpx;
  background: linear-gradient(90deg, #ff6a00, #ffb86b);
  color: #0f1724;
  font-size: 30rpx;
  font-weight: 700;
  box-shadow: 0 12rpx 36rpx rgba(255,120,40,0.12);
  border: none;
}

.btn-primary:active {
  opacity: 0.95;
}

/* small helper for neon subtitle */
.neon-sub {
  color: #ffd9b3;
  font-size: 22rpx;
  opacity: 0.95;
  text-shadow: 0 6rpx 24rpx rgba(255,120,40,0.08);
}
