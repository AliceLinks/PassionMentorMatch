page {
  background-color: #f7f8fa;
}
.container {
  padding: 16rpx;
}
.section-title {
  font-size: 32rpx;
  font-weight: 600;
  margin: 24rpx 0 16rpx;
}
.grid {
  display: grid;
  grid-template-columns: 1fr; /* 手机端单列，推荐在状态下方 */
  gap: 16rpx;
}
.card {
  background-color: #fff;
  border-radius: 12rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.06);
}
.card-body {
  padding: 16rpx;
}
.btn {
  background-color: #07c160;
  color: #fff;
  border-radius: 12rpx;
}
.btn-secondary {
  background-color: #efefef;
  color: #333;
  border-radius: 12rpx;
}
.btn, .btn-secondary, .btn-navigate {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 72rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
}
.btn-navigate {
  background-color: #e0f2fe;
  color: #0c4a6e;
  border-radius: 12rpx;
}
.card {
  border: 1rpx solid #e5e7eb;
}

/* 新增样式 */
.week-header {
  display: flex;
  justify-content: space-around;
  background: #fff;
  padding: 20rpx 0;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
}
.day-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  font-size: 24rpx;
  color: #666;
}
.date-num {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-top: 8rpx;
}

.course-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
}
.card-left { width: 180rpx; }
.card-center { flex: 1; padding: 0 20rpx; }
.card-right { width: 120rpx; text-align: right; }

.time { font-size: 32rpx; font-weight: bold; color: #333; }
.type { font-size: 24rpx; color: #666; margin-top: 8rpx; }
.teacher { font-size: 28rpx; color: #333; margin-bottom: 8rpx; }
.capacity { font-size: 22rpx; color: #999; display: flex; align-items: center; gap: 10rpx; }
.capacity progress { flex: 1; }

.mentor-card {
  background: linear-gradient(135deg, #333, #555);
  color: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  position: relative;
  overflow: hidden;
}
.mentor-card.active { background: linear-gradient(135deg, #07c160, #059669); }
.mentor-card.expired { background: linear-gradient(135deg, #9ca3af, #6b7280); }

.card-type { font-size: 36rpx; font-weight: bold; margin-bottom: 20rpx; }
.card-no { font-size: 28rpx; opacity: 0.8; }
.card-date { font-size: 24rpx; opacity: 0.8; margin-top: 10rpx; }
.card-status { position: absolute; right: 30rpx; top: 30rpx; font-size: 24rpx; border: 1px solid #fff; padding: 4rpx 12rpx; border-radius: 8rpx; }

.btn-disabled { background-color: #d1d5db; color: #6b7280; }
.btn-disabled:hover { background-color: #d1d5db; }
.btn-disabled:active { background-color: #9ca3af; }
