.change-pwd-btn {
	margin: 24px auto 0 auto;
	display: block;
	width: 220px;
	background: #fff;
	color: #15df33ff;
	border: 1px solid #10d70dff;
}

.container {
	padding: 16px;
	background: #f7f8fa;
	min-height: 100vh;
}

.hero {
	padding: 16px;
	background: #fff;
	border-radius: 12px;
	box-shadow: 0 6px 16px rgba(0, 0, 0, 0.08);
	margin-bottom: 14px;
}

.hero-title {
	font-size: 18px;
	font-weight: 700;
	color: #222;
}

.hero-sub {
	font-size: 12px;
	color: #888;
	margin-top: 4px;
}

.grid {
	display: grid;
	grid-template-columns: 1fr 1fr;
	gap: 12px;
}

.card {
	background: #fff;
	border-radius: 12px;
	box-shadow: 0 6px 16px rgba(0, 0, 0, 0.08);
	padding: 14px;
}

.card-icon {
	font-size: 22px;
}

.card-title {
	font-size: 16px;
	font-weight: 600;
	color: #222;
	margin-top: 6px;
}

.card-sub {
	font-size: 12px;
	color: #888;
	margin-top: 2px;
}

.logout-btn {
	margin: 12px auto 0 auto;
	display: block;
	width: 220px;
	background: #fff;
	color: #f44336;
	border: 1px solid #f44336;
}
