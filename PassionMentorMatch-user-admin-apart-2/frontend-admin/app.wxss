/* 管理端全局样式，可根据需要自定义 */
page { background: #f6f8fa; }

button[type="primary"],
button.primary,
button.btn,
.btn,
.btn-primary,
.primary {
  background: linear-gradient(90deg, #ff6a00, #ffb86b) !important;
  color: #0f1724 !important;
  border: none !important;
  font-weight: 700;
  border-radius: 999rpx;
  box-shadow: 0 12rpx 36rpx rgba(255,120,40,0.12);
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
  transition: background 0.3s;
}
button[type="primary"]:active,
button.primary:active,
button.btn:active,
.btn:active,
.btn-primary:active,
.primary:active {
  opacity: 0.95;
}

.btn-secondary {
  background: #fff7ed;
  color: #ff6a00;
  border: 1rpx solid #ffb86b;
  border-radius: 999rpx;
}

.btn-disabled {
  background: #e5e7eb;
  color: #9ca3af;
}
