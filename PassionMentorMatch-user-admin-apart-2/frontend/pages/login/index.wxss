.register-bg {
	min-height: 100vh;
	background: linear-gradient(135deg, #d1fae5 0%, #bbf7d0 100%);
	display: flex;
	align-items: center;
	justify-content: center;
}
.register-card {
	box-shadow: 0 8rpx 32rpx 0 rgba(34,197,94,0.10);
	margin: 0 auto;
	max-width: 600rpx;
}
.register-title {
	font-size: 32rpx;
	font-weight: 700;
	color: #ffffff;
	text-align: center;
	margin-bottom: 12rpx;
}
.register-btn {
	width: 100%;
	margin-top: 20rpx;
	background: linear-gradient(90deg,#22c55e,#4ade80);
	box-shadow: 0 4rpx 16rpx 0 rgba(34,197,94,0.10);
	transition: background 0.3s;
}
.register-btn:active {
	background: linear-gradient(90deg,#4ade80,#22c55e);
}
.login-btn {
	width: 100%;
	margin-top: 20rpx;
	background: linear-gradient(90deg,#6366f1,#38bdf8);
	box-shadow: 0 4rpx 16rpx 0 rgba(80,120,200,0.10);
	transition: background 0.3s;
}
.login-btn:active {
	background: linear-gradient(90deg,#38bdf8,#6366f1);
}
.btn-secondary {
	width: 100%;
	display: block;
	margin-top: 12rpx;
	height: 80rpx;
	border-radius: 999rpx;
	background: rgba(255,255,255,0.06);
	color: #fff;
	border: 1rpx solid rgba(255,255,255,0.08);
}
/* pages/login/index.wxss */
.card { background:#fff;border-radius:12rpx;overflow:hidden;border:1rpx solid #e5e7eb; }
.card-body { padding:16rpx; }
/* 页面背景与容器 */
.page {
  min-height: 100vh;
  padding: 40rpx 24rpx;
  background: linear-gradient(180deg,#071428,#071428 40%);
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
}

/* 顶部品牌 Hero（复用全局变量/风格）*/
.brand-hero {
  width: 100%;
  max-width: 760rpx;
  padding: 20rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: linear-gradient(135deg, rgba(255,255,255,0.02), rgba(255,255,255,0.01));
  box-shadow: 0 18rpx 40rpx rgba(2,6,23,0.6);
}

/* Logo：放大且透明背景 */
.brand-logo {
  width: 200rpx;
  height: 200rpx;
  border-radius: 24rpx;
  background: transparent;
  box-shadow: 0 18rpx 40rpx rgba(0,0,0,0.6);
  object-fit: contain;
}

/* 玻璃卡片复用全局 glass-card，但局部微调 */
.glass-card {
  width: 100%;
  max-width: 760rpx;
  border-radius: 18rpx;
  padding: 24rpx;
  box-sizing: border-box;
}

/* 输入样式 */
.input {
  height: 80rpx;
  width: 100%;
  padding: 0 20rpx;
  border-radius: 14rpx;
  background: rgba(255,255,255,0.03);
  color: #fff;
  font-size: 28rpx;
  border: 1rpx solid rgba(255,255,255,0.06);
  box-sizing: border-box;
}

/* 把表单置顶，确保不被遮挡并有显著背景 */
.card {
  position: relative;
  z-index: 999; /* 提升到最上层 */
  background: rgba(255,255,255,0.04); /* 半透明背景，配合 glass-card */
  -webkit-backdrop-filter: blur(6px);
  backdrop-filter: blur(6px);
}

/* 保证输入框可点、可触控 */
.input {
  -webkit-tap-highlight-color: transparent;
  touch-action: manipulation;
}