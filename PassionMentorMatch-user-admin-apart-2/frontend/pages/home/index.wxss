/* 首页整体背景美化 */
.container {
  min-height: 100vh;
  background: linear-gradient(135deg, #f5f6fa 60%, #fdf6e3 100%);
  padding: 32rpx 24rpx 40rpx;
  box-sizing: border-box;
}

/* 卡片美化 */
.card {
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.08);
  margin-bottom: 24rpx;
  padding: 0;
  overflow: hidden;
  transition: box-shadow 0.2s;
  border: none;
}
.card:hover {
  box-shadow: 0 16rpx 40rpx rgba(0,0,0,0.13);
}
.card-body {
  padding: 32rpx 20rpx 24rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-bottom: 1rpx solid #f5f6fa;
}
.card-body:last-child {
  border-bottom: none;
}

/* 主要按钮美化 */
.btn {
  background: linear-gradient(90deg, #ff7a45 0%, #ff4d4f 100%);
  color: #fff;
  border: none;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 700;
  padding: 0 28rpx;
  height: 68rpx;
  line-height: 68rpx;
  margin-right: 0;
  margin-bottom: 8rpx;
  box-shadow: 0 2rpx 8rpx rgba(255,122,69,0.10);
  transition: background 0.2s;
  letter-spacing: 1rpx;
}
.btn:active {
  background: linear-gradient(90deg, #ff4d4f 0%, #ff7a45 100%);
}
.btn-secondary {
  background: #f5f6fa;
  color: #ff7a45;
  border: 1rpx solid #ffe0c2;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 700;
  padding: 0 28rpx;
  height: 68rpx;
  line-height: 68rpx;
  margin-bottom: 8rpx;
  box-shadow: 0 1rpx 4rpx rgba(255,186,69,0.06);
  letter-spacing: 1rpx;
}

/* 卡片标题 */
.section-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #222;
  margin-bottom: 18rpx;
  letter-spacing: 1rpx;
  text-align: center;
}

/* 推荐课程样式优化 */
.rec-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 0;
  border-top: 1rpx solid #f0f0f0;
}
.rec-item:first-child {
  border-top: none;
}
.rec-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #222;
}
.rec-time {
  font-size: 24rpx;
  color: #ff7a45;
}
.card-half {
  flex: 1 1 0;
  min-width: 0;
}
@media screen and (max-width: 500px) {
  .row-cards {
    flex-direction: column;
    gap: 0;
  }
  .card-half {
    margin-bottom: 16rpx;
  }
}

/* muted 字体色 */
.muted {
  color: #b0b0b0;
  font-size: 24rpx;
  text-align: center;
}
/* 课程介绍与路线图并排卡片 */
.row-cards {
  display: flex !important;
  flex-direction: row !important;
  gap: 24rpx;
  margin-bottom: 24rpx;
  width: 100% !important;
  box-sizing: border-box;
}
.card-half {
  flex: 1 1 0 !important;
  min-width: 0 !important;
  width: 0 !important;
  min-height: 160rpx;
  display: flex !important;
  flex-direction: column !important;
  justify-content: center !important;
  box-sizing: border-box;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 18rpx rgba(0,0,0,0.07);
  margin-bottom: 0;
  transition: box-shadow 0.2s;
}
.card-half:hover {
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.13);
}
/* 顶部轮播图美化 */
.home-swiper {
  width: 100%;
  height: 320rpx;
  border-radius: 28rpx;
  overflow: hidden;
  margin-bottom: 32rpx;
  box-shadow: 0 12rpx 32rpx rgba(0,0,0,0.13);
  background: #fff;
}
.home-swiper .banner-img {
  width: 100%;
  height: 320rpx;
  object-fit: cover;
  display: block;
}
/* swiper 指示点美化 */
.wx-swiper-dot {
  width: 16rpx !important;
  height: 16rpx !important;
  background: #e5e7eb !important;
  opacity: 0.7;
  margin: 0 6rpx !important;
}
.wx-swiper-dot-active {
  background: #f97316 !important;
  opacity: 1;
}
/* 顶部街舞主题 Hero */
.profile-swiper {
  width: 100%;
  height: 450rpx; /* 加高，展示感更强 */
}
.hero {
  position: relative;
  margin-bottom: 20rpx;
  padding: 28rpx 24rpx;
  border-radius: 24rpx;
  background: radial-gradient(circle at 0 0, #f97316 0, transparent 45%),
  radial-gradient(circle at 100% 100%, #22c55e 0, transparent 40%),
  linear-gradient(135deg, #020617, #111827);
  box-shadow: 0 18rpx 40rpx rgba(15,23,42,0.55);
  display: flex;
  align-items: center;
  overflow: hidden;
}

.hero::after {
  content: '';
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(60deg, rgba(248,250,252,0.08) 1px, transparent 0),
    linear-gradient(-60deg, rgba(15,23,42,0.6) 1px, transparent 0);
  background-size: 40rpx 40rpx;
  opacity: 0.28;
  mix-blend-mode: screen;
  pointer-events: none;
}

.hero-left {
  position: relative;
  z-index: 1;
  margin-right: 24rpx;
}

.hero-right {
  position: relative;
  z-index: 1;
  flex: 1;
  color: #e5e7eb;
}

.hero-badge {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  letter-spacing: 2rpx;
  text-transform: uppercase;
  color: #f97316;
  background: rgba(15,23,42,0.75);
  border: 1rpx solid rgba(248,250,252,0.16);
  margin-bottom: 10rpx;
}

.hero-title {
  font-size: 36rpx;
  font-weight: 800;
  color: #f9fafb;
  text-shadow: 0 3rpx 8rpx rgba(0,0,0,0.6);
}

.hero-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #e5e7eb;
  opacity: 0.95;
}

.title { font-size:36rpx;font-weight:700;color:#111; }
.subtitle { color:#666;margin-top:8rpx; }
.row { display:grid; grid-template-columns: 1fr auto; align-items:center; }
.label { color:#222; font-weight:700; font-size: 28rpx; }
.value { color:#ff7a45; font-weight: 700; font-size: 28rpx; }
.row-sub { margin-top:8rpx; }
.actions { display:flex; gap:12rpx; margin-top:12rpx; }
.rec-item { display:grid; grid-template-columns: 1fr auto; align-items:center; padding:8rpx 0; border-top:1rpx solid #f0f0f0; }
.rec-item:first-child { border-top:none; }

.rec-title { font-size:30rpx;font-weight:600; }
.rec-time { font-size:24rpx; }
.section-title { font-size:28rpx; font-weight:600; margin-bottom:8rpx; }
.link { color: #07c160; text-decoration: underline; }

.btn,
button.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 28rpx !important;
}


