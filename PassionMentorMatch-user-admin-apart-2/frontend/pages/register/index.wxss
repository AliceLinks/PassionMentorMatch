
.register-bg {
	min-height: 100vh;
	background: linear-gradient(135deg, #e0e7ff 0%, #f0fdfa 100%);
	display: flex;
	align-items: center;
	justify-content: center;
}
.register-card {
	box-shadow: 0 8rpx 32rpx 0 rgba(80,120,200,0.10);
	margin: 0 auto;
	max-width: 600rpx;
}
.register-title {
	font-size: 36rpx;
	font-weight: bold;
	color: #222;
	text-align: center;
	margin-bottom: 32rpx;
}
.register-bg {
	min-height: 100vh;
	background: linear-gradient(135deg, #d1fae5 0%, #bbf7d0 100%);
	display: flex;
	align-items: center;
	justify-content: center;
}
.register-card {
	box-shadow: 0 8rpx 32rpx 0 rgba(34,197,94,0.10);
	margin: 0 auto;
	max-width: 600rpx;
}
.register-title {
	font-size: 36rpx;
	font-weight: bold;
	color: #166534;
	text-align: center;
	margin-bottom: 32rpx;
}
.register-btn {
	margin-top: 24rpx;
	background: linear-gradient(90deg,#22c55e,#4ade80);
	box-shadow: 0 4rpx 16rpx 0 rgba(34,197,94,0.10);
	transition: background 0.3s;
}
.register-btn:active {
	background: linear-gradient(90deg,#4ade80,#22c55e);
}
.avatar-btn { display:flex;flex-direction:column;align-items:center;justify-content:center;margin-bottom:16rpx;background:none;border:none; }
.avatar { width:96rpx;height:96rpx;border-radius:50%;background:#f2f2f2; }
.avatar-tip { color:#888;font-size:22rpx;margin-top:4rpx; }
